/* Universal routing smoke-test keymap. Not a user-ready firmware. */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        hana_base_layer {
            display-name = "HANA_BASE";
            bindings = <
                &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp LBKT   &kp RBKT
                &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT    &kp BSPC
                &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp UP     &kp DOWN
                                           &kp LCTRL  &kp LALT   &kp LGUI   &kp SPACE  &kp RET
                                           &kp TAB    &kp BSPC   &kp DEL    &kp LEFT   &kp RIGHT
            >;
        };

        chocofi_base_layer {
            display-name = "CHOCOFI_BASE";
            bindings = <
                &trans     &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &trans
                &trans     &trans     &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &trans
                &trans     &trans     &kp Z      &kp X      &kp C      &kp V      &kp B      &trans     &trans     &kp N      &kp M      &kp COMMA
                                           &kp FSLH   &trans     &trans     &kp LGUI   &kp RET
                                           &kp SPACE  &trans     &kp DEL    &kp SPACE  &kp BSPC
            >;
        };
    };
};
