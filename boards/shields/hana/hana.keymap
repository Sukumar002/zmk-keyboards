#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "../common/studio_features.dtsi"
#include "../common/studio_runtime_layers.dtsi"
#include "../common/studio_unlock_combo.dtsi"


#define BASE  0
#define NUM   1
#define NAV   2
#define SET   3
#define MOUSE 4


// Layout-shift behavior and GUI/Alt mapping come from the shared feature include.

// Tune all Hana mod-tap keys for easier rolling/typing.
// Keep the 200 ms tapping term, but avoid hold-preferred's aggressive modifier activation.
&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    hold-trigger-key-positions = <
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
    >;
    runtime-editable;
    runtime-default-active;
    display-name = "Mod-Tap";
};

&lt {
    hold-trigger-key-positions = <
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
    >;
    runtime-editable;
    runtime-default-active;
    display-name = "Layer-Tap";
};

&bt_profile_shared {
    hold-trigger-key-positions = <
                0xffffffff 0xffffffff 0xffffffff 0xffffffff
                0xffffffff 0xffffffff 0xffffffff 0xffffffff
                0xffffffff 0xffffffff 0xffffffff 0xffffffff
                0xffffffff 0xffffffff 0xffffffff 0xffffffff
                0xffffffff 0xffffffff 0xffffffff 0xffffffff
                0xffffffff 0xffffffff 0xffffffff 0xffffffff
                0xffffffff 0xffffffff 0xffffffff 0xffffffff
                0xffffffff 0xffffffff 0xffffffff 0xffffffff
            >;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
                &lt SET TAB  &kp Q              &kp W      &kp E      &kp R      &kp T                         &kp Y      &kp U      &kp I      &kp O      &kp P              &kp BSPC
                &mt LSHIFT GRAVE    &mt LSHIFT A       &kp S      &kp D      &kp F      &kp G                         &kp H      &kp J      &kp K      &kp L      &mt RSHIFT SEMI    &mt RSHIFT SQT
                &mt LCTRL ESC       &kp Z              &kp X      &kp C      &kp V      &kp B      &kp C_MUTE  &kp C_PP &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH           &mt RCTRL DEL
                                      &mt LCTRL CAPS     &mt LALT BSPC        &mt LGUI RET &lt NUM SPACE                   &lt NAV RET &mt LGUI SPACE &mt LALT DEL &lt MOUSE RALT
            >;
        };

        num_layer {
            display-name = "Num";
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp F11 &kp F12
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET &trans &trans &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp PLUS &kp EQUAL
                &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        nav_layer {
            display-name = "Nav";
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
                &trans &trans &trans &trans &trans &trans &kp HOME &kp PG_DN &kp PG_UP &kp END &kp INS &kp DEL
                &trans &trans &trans &trans &trans &trans &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp C_VOL_DN &kp C_VOL_UP
                &trans &trans &trans &trans &trans &trans &trans &trans &kp C_BRI_DN &kp C_BRI_UP &kp C_MUTE &kp CAPS &kp C_VOL_DN &kp C_VOL_UP
                &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        set_layer {
            display-name = "Set";
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
                &tog_ls  &bt_profile_shared 0 0      &bt_profile_shared 1 1  &bt_profile_shared 2 2  &bt_profile_shared 3 3  &bt_profile_shared 4 4       &bootloader  &none  &base_view_tog_shared  &timeout_cycle_shared 1  &timeout_cycle_shared 0  &oled_tog_shared
                &none     &none               &none          &none          &none          &none                          &none        &none  &none  &none  &none  &none
                &none     &out OUT_TOG        &none          &none          &bt BT_CLR_ALL &none        &none    &none   &none        &none  &none  &none  &none  &none
                           &none               &none          &none          &none                                      &none        &none  &none  &none
            >;
        };


        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
                &trans    &trans             &trans        &trans        &trans        &trans                         &msc SCRL_LEFT  &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans
                &trans    &mkp LCLK          &mkp MCLK     &mkp RCLK     &trans        &trans                         &trans          &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT &trans            &trans
                &trans    &trans             &trans        &trans        &trans        &trans       &trans    &trans  &trans          &trans          &trans          &trans          &trans            &trans
                           &trans             &trans        &trans        &trans                                  &trans          &trans          &trans          &trans
            >;
        };


        ZMK_STUDIO_RUNTIME_LAYER_SLOTS_4
    };
};
