#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define MAC_BASE   0
#define WIN_BASE   1
#define NUM        2
#define NAV        3
#define CONNECTION 4

// Tune all Hana mod-tap keys for easier rolling/typing.
// Keep the 200 ms tapping term, but avoid hold-preferred's aggressive modifier activation.
&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        mac_base {
            display-name = "MAC Base";
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
                &lt CONNECTION TAB  &kp Q              &kp W      &kp E      &kp R      &kp T                         &kp Y      &kp U      &kp I      &kp O      &kp P              &kp BSPC
                &mt LSHIFT GRAVE    &mt LSHIFT A       &kp S      &kp D      &kp F      &kp G                         &kp H      &kp J      &kp K      &kp L      &mt RSHIFT SEMI    &mt RSHIFT SQT
                &mt LCTRL ESC       &kp Z              &kp X      &kp C      &kp V      &kp B      &kp C_MUTE  &kp C_PP &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH           &mt RCTRL DEL
                                      &mt LCTRL CAPS     &mt LALT BSPC        &mt LGUI RET &lt NUM SPACE                   &lt NAV RET &mt LGUI SPACE &mt LALT DEL &studio_unlock
            >;
        };

        win_base {
            display-name = "WIN Base";
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
                &lt CONNECTION TAB  &kp Q              &kp W      &kp E      &kp R      &kp T                         &kp Y      &kp U      &kp I      &kp O      &kp P              &kp BSPC
                &mt LSHIFT GRAVE    &mt LSHIFT A       &kp S      &kp D      &kp F      &kp G                         &kp H      &kp J      &kp K      &kp L      &mt RSHIFT SEMI    &mt RSHIFT SQT
                &mt LCTRL ESC       &kp Z              &kp X      &kp C      &kp V      &kp B      &kp C_MUTE  &kp C_PP &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH           &mt RCTRL DEL
                                      &mt LCTRL CAPS     &mt LGUI BSPC        &mt LALT RET &lt NUM SPACE                   &lt NAV RET &mt LALT SPACE &mt LGUI DEL &studio_unlock
            >;
        };

        num_layer {
            display-name = "NUM";
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
                &kp F11   &kp F1             &kp F2    &kp F3    &kp F4    &kp F5                      &kp F6     &kp F7     &kp F8     &kp F9     &kp F10            &trans
                &kp F12   &mt LSHIFT N1      &kp N2    &kp N3    &kp N4    &kp N5                      &kp N6     &kp N7     &kp N8     &kp N9     &mt RSHIFT N0     &trans
                &trans    &trans             &trans     &kp BSLH  &kp LBRC  &kp RBRC  &trans    &trans &kp EQUAL  &kp MINUS  &trans     &trans     &trans             &trans
                           &trans             &trans     &trans    &trans                              &trans      &trans      &trans     &trans
            >;
        };

        nav_layer {
            display-name = "NAV";
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
                &trans    &trans             &trans       &trans       &trans       &trans                        &kp C_VOL_UP  &kp HOME    &kp UP       &kp END      &kp PG_UP    &kp BSPC
                &trans    &trans             &kp EQUAL    &kp LBRC     &kp RBRC     &kp C_VOL_UP                  &kp C_VOL_DN  &kp LEFT    &kp DOWN     &kp RIGHT    &kp RSHIFT   &trans
                &trans    &trans             &kp C_BRI_DN &kp C_BRI_UP &kp C_MUTE  &kp CAPS    &trans    &trans &kp C_MUTE   &kp EQUAL   &kp LBRC     &kp RBRC     &trans       &kp DEL
                           &trans             &trans       &trans       &trans                                 &trans         &trans       &trans        &tog WIN_BASE
            >;
        };

        connection_layer {
            display-name = "Connection";
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
                &none     &bt BT_SEL 0        &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                   &bootloader  &none  &none  &none  &none  &none
                &none     &none               &none          &none          &none          &none                          &none        &none  &none  &none  &none  &none
                &none     &out OUT_TOG        &none          &none          &bt BT_CLR_ALL &bt BT_CLR   &none    &none   &none        &none  &none  &none  &none  &none
                           &none               &none          &none          &none                                      &none        &none  &none  &none
            >;
        };
    };
};
