/* Chocofi 5-column keymap restored from the ZMK Studio export.
 * SPDX-License-Identifier: MIT
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "../common/studio_features.dtsi"
#include "../common/studio_runtime_layers.dtsi"
#include <dt-bindings/zmk/keys.h>

/* Match Hana's responsive mod-tap timing and the Studio-exported settings. */
&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <(-1)>;
    hold-trigger-key-positions = <
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
    >;
    runtime-editable;
    runtime-default-active;
    display-name = "Mod-Tap";
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <(-1)>;
    hold-trigger-key-positions = <
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
    >;
    runtime-editable;
    runtime-default-active;
    display-name = "Layer-Tap";
};

&bt_profile_shared {
    hold-trigger-key-positions = <
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
    >;
};

/ {
    behaviors {
        base_view_tog_chocofi: base_view_toggle_chocofi {
            compatible = "zmk,behavior-base-view-toggle";
            #binding-cells = <0>;
            display-name = "BASE View Cycle";
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&studio_unlock>;
        };

        combo_alt_tab {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&mt LALT TAB>;
        };

        combo_grave_gui {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&mt LGUI GRAVE>;
        };

        combo_bksp_alt {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&mt LALT BACKSPACE>;
        };

        combo_quote_ctrl {
            timeout-ms = <50>;
            key-positions = <17 19>;
            bindings = <&mt LCTRL SQT>;
        };

        combo_del_gui {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&mt RGUI DELETE>;
        };

        combo_mouse_layer {
            timeout-ms = <50>;
            key-positions = <12 13 14>;
            bindings = <&lt 4 ESC>;
        };

        combo_set_layer {
            timeout-ms = <50>;
            key-positions = <35 36>;
            bindings = <&lt 3 CAPSLOCK>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp Q              &kp W              &kp E              &kp R              &kp T              &kp Y              &kp U              &kp I              &kp O              &kp P
                &mt LSHIFT A       &mt LGUI S         &mt LALT D         &mt LCTRL F        &kp G              &kp H              &mt RCTRL J        &mt LALT K         &mt LGUI L         &mt RSHIFT SEMI
                &mt LCTRL Z        &kp X              &kp C              &kp V              &kp B              &kp N              &kp M              &kp COMMA          &kp DOT            &mt RCTRL FSLH
                                        &mt LALT ESC    &mt LGUI ENTER    &lt 1 TAB         &lt 2 ENTER        &mt LGUI SPACE     &mt LALT BACKSPACE
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                &kp N1             &kp N2             &kp N3             &kp N4             &kp N5             &kp N6             &kp N7             &kp N8             &kp N9             &kp N0
                &mt LSHIFT N1      &kp N2             &kp N3             &kp N4             &kp N5             &kp N6             &kp N7             &kp N8             &kp N9             &mt RSHIFT N0
                &kp F11            &kp F12            &kp BSLH           &kp LBKT           &kp RBKT           &kp EQUAL          &kp MINUS          &trans             &trans             &trans
                                        &trans          &trans             &trans            &trans             &trans             &kp COLON
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &kp F10            &kp F7             &kp F8             &kp F9             &kp SCROLLLOCK    &kp C_VOL_UP       &kp HOME           &kp UP_ARROW       &kp END            &kp PAGE_UP
                &kp F11            &kp F4             &kp F5             &kp F6             &kp KP_NUMLOCK       &kp C_VOL_DN       &kp LEFT           &kp DOWN           &kp RIGHT          &kp PAGE_DOWN
                &kp F12            &kp N1             &kp N2             &kp N3             &kp CAPSLOCK       &kp C_MUTE         &trans             &trans             &trans             &trans
                                        &trans          &trans             &trans            &trans             &trans             &trans
            >;
        };

        set_layer {
            display-name = "Set";
            bindings = <
                &bt BT_SEL 0        &bt BT_SEL 1        &bt BT_SEL 2        &bt BT_SEL 3        &bt_profile_shared 4 4  &bootloader  &base_view_tog_chocofi  &timeout_cycle_shared 1  &timeout_cycle_shared 0  &oled_tog_shared
                &none                &none                &none                &none                &none                &none        &none                   &none                    &none                    &none
                &out OUT_TOG         &bt BT_CLR_ALL      &none                &none                &none                &none        &none                   &none                    &none                    &tog_ls
                                        &trans             &trans               &trans              &trans              &trans       &trans
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans
                &trans  &trans  &trans  &trans  &trans  &msc SCRL_DOWN  &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
                &trans  &trans  &trans  &trans  &trans  &trans         &trans         &trans          &trans           &trans
                        &trans  &mkp MB4 &mkp MB5 &mkp RCLK &mkp LCLK &mkp MCLK
            >;
        };

        ZMK_STUDIO_RUNTIME_LAYER_SLOTS_4
    };
};
