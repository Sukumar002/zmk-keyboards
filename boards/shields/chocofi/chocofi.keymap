/* Chocofi reference keymap: common five-layer layout. SPDX-License-Identifier: MIT */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/keys.h>
#include "../common/studio_features.dtsi"
#include "../common/studio_runtime_layers.dtsi"
#include "../common/studio_unlock_combo.dtsi"

#define BASE  0
#define NUM   1
#define NAV   2
#define SET   3
#define MOUSE 4

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    hold-trigger-key-positions = <
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
    >;
};
&lt {
    hold-trigger-key-positions = <
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
    >;
};
&bt_profile_shared {
    hold-trigger-key-positions = <
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
    >;
};
/ {
    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "Base";
            bindings = <
                &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O        &kp P
                &mt LSHIFT A &mt LALT S   &mt LGUI D   &mt LCTRL F  &kp G        &kp H        &mt RCTRL J  &mt RGUI K   &mt LALT L   &mt RSHIFT SEMI
                &kp Z        &kp X        &kp C        &kp V        &kp B        &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH
                                      &kp LGUI &lt NUM RET &kp SPACE &lt MOUSE DEL &lt NAV SPACE &lt SET BSPC
            >;
        };
        num_layer {
            display-name = "Num";
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
                &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR
                                      &trans &trans &trans &trans &trans &trans
            >;
        };
        nav_layer {
            display-name = "Nav";
            bindings = <
                &kp INS &kp HOME &kp PG_DN &kp PG_UP &kp END &kp HOME &kp PG_DN &kp PG_UP &kp END &kp DEL
                &kp TAB &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp BSPC
                &kp ESC &kp C_BRI_DN &kp C_BRI_UP &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans &trans &trans &trans
                                      &trans &trans &trans &trans &trans &trans
            >;
        };
        set_layer {
            display-name = "Set";
            bindings = <
                &bt_profile_shared 0 0 &bt_profile_shared 1 1 &bt_profile_shared 2 2 &bt_profile_shared 3 3 &bt_profile_shared 4 4 &out OUT_TOG &tog_ls &oled_tog_shared &base_view_tog_shared &timeout_cycle_shared 1
                &timeout_cycle_shared 0 &bt BT_CLR_ALL &bootloader &sys_reset &trans &trans &trans &trans &oled_brightness_shared 0  &oled_brightness_shared 1
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                                      &trans &trans &trans &trans &trans &trans
            >;
        };
        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &msc SCRL_LEFT &msc SCRL_UP &mmv MOVE_UP &msc SCRL_DOWN &msc SCRL_RIGHT &trans &trans &trans &trans &trans
                &mkp LCLK &mkp MCLK &mkp RCLK &trans &trans &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                                      &trans &trans &trans &trans &trans &trans
            >;
        };
        ZMK_STUDIO_RUNTIME_LAYER_SLOTS_4
    };
};
