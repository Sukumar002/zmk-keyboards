/* Chocofi five-layer keymap with six thumbs. SPDX-License-Identifier: MIT */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "../common/studio_features.dtsi"
#include "../common/studio_runtime_layers.dtsi"
#include <dt-bindings/zmk/keys.h>

/* Hold-tap timing is inherited from common/personal_hold_tap.dtsi.
 * Keep only the Chocofi trigger-position behavior board-specific. */
&mt {
    hold-trigger-key-positions = <
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
    >;
};

&lt {
    hold-trigger-key-positions = <
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
        0xffffffff 0xffffffff 0xffffffff 0xffffffff
    >;
};

/ {
    behaviors {
        base_view_tog_chocofi: base_view_toggle_chocofi {
            compatible = "zmk,behavior-base-view-toggle";
            #binding-cells = <0>;
            display-name = "BASE View Cycle";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            display-name = "Studio Unlock";
            timeout-ms = <50>;
            require-prior-idle-ms = <(-1)>;
            key-positions = <0 1>;
            bindings = <&studio_unlock>;
        };

        combo_set_layer {
            display-name = "SET Layer";
            timeout-ms = <50>;
            require-prior-idle-ms = <(-1)>;
            key-positions = <32 33>;
            bindings = <&lt 3 ESC>;
        };

        combo_backspace {
            display-name = "Backspace";
            timeout-ms = <50>;
            require-prior-idle-ms = <(-1)>;
            key-positions = <16 17>;
            bindings = <&mt LALT BSPC>;
        };

        combo_delete {
            display-name = "Delete";
            timeout-ms = <50>;
            require-prior-idle-ms = <(-1)>;
            key-positions = <17 18>;
            bindings = <&mt LGUI DEL>;
        };

        combo_apos {
            display-name = "Apos";
            timeout-ms = <50>;
            require-prior-idle-ms = <(-1)>;
            key-positions = <16 18>;
            bindings = <&mt RCTRL APOS>;
        };

        combo_tab {
            display-name = "TAB";
            timeout-ms = <50>;
            require-prior-idle-ms = <(-1)>;
            key-positions = <12 13>;
            bindings = <&mt LALT TAB>;
        };

        combo_grave {
            display-name = "Grave";
            timeout-ms = <50>;
            require-prior-idle-ms = <(-1)>;
            key-positions = <11 12>;
            bindings = <&mt LGUI GRAVE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp Q              &kp W              &kp E              &kp R              &kp T              &kp Y              &kp U              &kp I              &kp O              &kp P
                &mt LSHIFT A       &mt LGUI S         &mt LALT D         &mt LCTRL F        &kp G              &kp H              &mt RCTRL J        &mt LALT K         &mt LGUI L         &mt RSHIFT SEMI
                &mt LCTRL Z        &kp X              &kp C              &kp V              &kp B              &kp N              &kp M              &kp COMMA          &kp DOT            &mt RCTRL FSLH
                                        &mt LALT ESC    &mt LGUI ENTER    &lt 1 TAB         &lt 2 ENTER        &mt LGUI SPACE     &mt LALT BACKSPACE
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                &kp N1             &kp N2             &kp N3             &kp N4             &kp N5             &kp N6             &kp N7             &kp N8             &kp N9             &kp N0
                &mt LSHIFT N1      &kp N2             &kp N3             &kp N4             &kp N5             &kp N6             &kp N7             &kp N8             &kp N9             &mt RSHIFT N0
                &kp F11            &kp F12            &kp BSLH           &kp LBKT           &kp RBKT           &kp EQUAL          &kp MINUS          &trans             &trans             &trans
                                        &trans          &trans             &trans            &trans             &trans             &kp COLON
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &kp F10            &kp F7             &kp F8             &kp F9             &kp SCROLLLOCK     &kp C_VOL_UP       &kp HOME           &kp UP_ARROW       &kp END            &kp PAGE_UP
                &kp F11            &kp F4             &kp F5             &kp F6             &kp KP_NUMLOCK     &kp C_VOL_DN       &kp LEFT           &kp DOWN           &kp RIGHT          &kp PAGE_DOWN
                &kp F12            &kp N1             &kp N2             &kp N3             &kp CAPSLOCK       &kp C_MUTE         &trans              &trans              &trans              &trans
                                        &trans          &trans             &trans            &trans             &trans             &trans
            >;
        };

        set_layer {
            display-name = "Set";
            bindings = <
                &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3       &bt BT_SEL 4       &bootloader        &base_view_tog_chocofi &timeout_cycle_shared 1 &timeout_cycle_shared 0 &oled_tog_shared
                &none              &none              &none              &none              &none              &none              &none              &none              &none              &none
                &out OUT_TOG       &bt BT_CLR_ALL     &none              &none              &none              &none              &none              &none              &none              &tog_ls
                                        &trans          &trans             &trans            &trans             &trans             &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans
                &trans  &trans  &trans  &trans  &trans  &msc SCRL_DOWN  &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
                &trans  &trans  &trans  &trans  &trans  &trans         &trans         &trans          &trans           &trans
                        &trans  &mkp MB4 &mkp MB5 &mkp RCLK &mkp LCLK &mkp MCLK
            >;
        };

        ZMK_STUDIO_RUNTIME_LAYER_SLOTS_4
    };
};
