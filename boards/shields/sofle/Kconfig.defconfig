if SHIELD_SOFLE_CENTRAL_DONGLE || SHIELD_SOFLE_CENTRAL_DONGLE_128X64 || SHIELD_SOFLE_CENTRAL_DONGLE_128X32 || SHIELD_SOFLE_CENTRAL_LEFT
config ZMK_SPLIT_ROLE_CENTRAL
    default y
endif
if SHIELD_SOFLE_CENTRAL_DONGLE || SHIELD_SOFLE_CENTRAL_DONGLE_128X64 || SHIELD_SOFLE_CENTRAL_DONGLE_128X32
config ZMK_KEYBOARD_NAME
    default "sofle.dongle"
endif
if SHIELD_SOFLE_CENTRAL_LEFT
config ZMK_KEYBOARD_NAME
    default "sofle.central"
endif
if SHIELD_SOFLE_PERIPHERAL_LEFT
config ZMK_KEYBOARD_NAME
    default "sofle.left"
endif
if SHIELD_SOFLE_PERIPHERAL_RIGHT
config ZMK_KEYBOARD_NAME
    default "sofle.right"
endif
if SHIELD_SOFLE_CENTRAL_DONGLE || SHIELD_SOFLE_CENTRAL_DONGLE_128X64 || SHIELD_SOFLE_CENTRAL_DONGLE_128X32 || SHIELD_SOFLE_CENTRAL_LEFT || SHIELD_SOFLE_PERIPHERAL_LEFT || SHIELD_SOFLE_PERIPHERAL_RIGHT
config ZMK_SPLIT
    default y
config ZMK_SLEEP
    default y
config EC11
    default y
choice EC11_TRIGGER_MODE
    default EC11_TRIGGER_GLOBAL_THREAD
    depends on EC11
endchoice
if ZMK_DISPLAY
config I2C
    default y
config SSD1306
    default y
endif
if LVGL
config LV_Z_VDB_SIZE
    default 64
config LV_DPI_DEF
    default 148
config LV_Z_BITS_PER_PIXEL
    default 1
choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice
endif
endif
