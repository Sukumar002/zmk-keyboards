    def_bool $(shields_list_contains,sofle_central_dongle_128x64)
config SHIELD_SOFLE_CENTRAL_DONGLE_128X32
    def_bool $(shields_list_contains,sofle_central_dongle_128x32)
config SHIELD_SOFLE_CENTRAL_LEFT
