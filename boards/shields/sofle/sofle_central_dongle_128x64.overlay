#include "sofle_central_dongle.overlay"

/*
 * Match the controller properties of the physically tested Sweep 128x64
 * dongle exactly. Do not enable COM sequential mode or display inversion:
 * neither is present in the working Sweep configuration.
 *
 * Reuse the existing SSD1306 node to avoid duplicate-address node merging.
 */
&oled {
    width = <128>;
    height = <64>;
    segment-offset = <0>;
    page-offset = <0>;
    display-offset = <0>;
    multiplex-ratio = <63>;
    segment-remap;
    com-invdir;
    prechargep = <0x22>;
    status = "okay";
};

/ {
    chosen {
        zephyr,display = &oled;
    };
};
