#include "sofle_central_dongle.overlay"

/*
 * Keep the same SSD1306 controller setup as the Sweep dongle that was
 * physically validated with this 128x64 panel. Reuse Sofle's existing node
 * so Zephyr does not merge duplicate ssd1306@3c definitions.
 */
&oled {
    width = <128>;
    height = <64>;
    segment-offset = <0>;
    page-offset = <0>;
    display-offset = <0>;
    multiplex-ratio = <63>;
    segment-remap;
    com-invdir;
    prechargep = <0x22>;
    status = "okay";
};

/ {
    chosen {
        zephyr,display = &oled;
    };
};
