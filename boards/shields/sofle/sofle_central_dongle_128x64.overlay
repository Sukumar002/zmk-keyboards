#include "sofle_central_dongle.overlay"

/*
 * Reuse the OLED node declared by sofle.dtsi.
 *
 * Zephyr merges child nodes with the same unit address on the same I2C bus.
 * Declaring a second ssd1306@3c and disabling &oled disables the merged node,
 * including the 128x64 display selected by this overlay.
 */
&oled {
    width = <128>;
    height = <64>;
    multiplex-ratio = <63>;
    com-sequential;
    inversion-on;
    status = "okay";
};

/ {
    chosen {
        zephyr,display = &oled;
    };
};
