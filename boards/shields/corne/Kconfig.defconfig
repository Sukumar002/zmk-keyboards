if SHIELD_CORNE_CENTRAL_DONGLE || SHIELD_CORNE_CENTRAL_DONGLE_128X64 || SHIELD_CORNE_CENTRAL_DONGLE_128X32
config ZMK_KEYBOARD_NAME
    default "corne.dongle"
endif
if SHIELD_CORNE_CENTRAL_LEFT
config ZMK_KEYBOARD_NAME
    default "corne.central"
endif
if SHIELD_CORNE_PERIPHERAL_LEFT
config ZMK_KEYBOARD_NAME
    default "corne.left"
endif
if SHIELD_CORNE_PERIPHERAL_RIGHT
config ZMK_KEYBOARD_NAME
    default "corne.right"
endif
if SHIELD_CORNE_CENTRAL_DONGLE || SHIELD_CORNE_CENTRAL_DONGLE_128X64 || SHIELD_CORNE_CENTRAL_DONGLE_128X32 || SHIELD_CORNE_CENTRAL_LEFT || SHIELD_CORNE_PERIPHERAL_LEFT || SHIELD_CORNE_PERIPHERAL_RIGHT
config ZMK_SPLIT
    default y
config ZMK_SLEEP
    default y
if ZMK_DISPLAY
config I2C
    default y
config SSD1306
    default y
endif
if LVGL
config LV_Z_VDB_SIZE
    default 64
config LV_DPI_DEF
    default 148
config LV_Z_BITS_PER_PIXEL
    default 1
choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice
endif
